{
  "name": "neo-lloyds",
  "private": true,
  "version": "0.1.0",
  "description": "Neo-Lloyds — AI-native risk capital marketplace infrastructure (SIMULATION / TEST ENVIRONMENT — NOT INSURANCE)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --ext .ts",
    "db:generate": "npm -w @neo-lloyds/database run generate",
    "db:migrate": "npm -w @neo-lloyds/database run migrate"
  },
  "devDependencies": {
    "@swc/core": "^1.15.47",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^8.57.1",
    "typescript": "^5.7.2",
    "unplugin-swc": "^1.5.11",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
