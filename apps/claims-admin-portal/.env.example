# Neo-Lloyds Claims Administrator Portal — local development

NEO_LLOYDS_API_URL=http://localhost:3001

# --- WorkOS AuthKit (optional; see README.md) ---
# Unset -> the "Sign in with WorkOS" button on /login doesn't render, and
# the portal behaves exactly as before this was added (paste-a-credential
# login only).
#
# The "Neo-Lloyds" WorkOS project has two environments, each a completely
# separate data store (an organisation created in one does not exist in
# the other) -- use the pair that matches where this portal itself runs.
#
# Staging (local development target):
WORKOS_CLIENT_ID=client_01M0DMPW9VVWVXC5PZHAEW6S2K
WORKOS_ORGANIZATION_ID=org_01M0DMQZE6GYX4PV7ZPG5JH6QN
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
#
# Production ("NEO-LLYODS" environment) -- redirect/logout/CORS URIs are
# NOT configured on this environment yet (no real production domain
# exists yet to point them at -- see README.md). Do not set
# NEXT_PUBLIC_WORKOS_REDIRECT_URI to this environment's callback until
# that's done; sign-in will fail with an invalid-redirect-uri error until
# then.
# WORKOS_CLIENT_ID=client_01M0E0T17YFVEH6BDC9GG1MYBV
# WORKOS_ORGANIZATION_ID=org_01M0E14TSTRZK9GEZRR7RWZPAK
#
# From the matching environment's dashboard page
# (https://dashboard.workos.com -> Neo-Lloyds -> <environment> -> API Keys)
# -- never commit the real value, and treat it as compromised (rotate it)
# if it was ever pasted anywhere outside that dashboard, including chat:
# WORKOS_API_KEY=sk_...
WORKOS_COOKIE_PASSWORD=          # 32+ chars, e.g. `openssl rand -base64 24`
