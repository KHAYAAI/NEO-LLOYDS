// Neo-Lloyds — Phase 1 schema (identity + risk graph).
// SIMULATION / TEST ENVIRONMENT — NOT INSURANCE.
//
// Later phases add their own models and migrations rather than pre-building
// tables we cannot yet exercise (docs/roadmap.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- identity

enum OrganisationKind {
  COMPANY
  INDIVIDUAL
  AI_AGENT
  REGULATOR
}

enum KybStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum MarketRole {
  RISK_ORIGINATOR
  BROKER
  UNDERWRITER
  SYNDICATE
  CAPITAL_PROVIDER
  REINSURER
  INSURER
  CLAIMS_ADMINISTRATOR
  SETTLEMENT_PROVIDER
  REGULATOR
}

model Organisation {
  id           String           @id @default(uuid())
  legalName    String
  kind         OrganisationKind
  /// ISO-3166-1 alpha-2. Never defaulted (ADR-0004).
  jurisdiction String           @db.Char(2)
  kybStatus    KybStatus        @default(UNVERIFIED)
  active       Boolean          @default(true)

  /// Required for AI_AGENT: the legally responsible principal.
  principalOrganisationId String?
  principal               Organisation?  @relation("AgentPrincipal", fields: [principalOrganisationId], references: [id])
  agents                  Organisation[] @relation("AgentPrincipal")

  roles          OrganisationRole[]
  users          User[]
  credentials    ApiCredential[]
  mandates       AgentMandate[]     @relation("MandateAgent")
  grantedMandates AgentMandate[]    @relation("MandatePrincipal")
  nodes          RiskNode[]
  auditRecords   AuditRecord[]
  submissions           RiskSubmission[]
  underwritingAssessments UnderwritingAssessment[]
  listings              MarketListing[]
  capitalAppetite        CapitalAppetiteProfile?
  capitalInterests       CapitalInterest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jurisdiction])
  @@index([principalOrganisationId])
}

/// Each market function is a separate, separately auditable grant.
model OrganisationRole {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  role           MarketRole
  grantedAt      DateTime     @default(now())
  grantedBy      String

  @@unique([organisationId, role])
  @@index([role])
}

model User {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  email          String       @unique
  displayName    String
  active         Boolean      @default(true)
  /// Scopes granted to this user within the organisation.
  scopes         String[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organisationId])
}

/// Secrets are stored only as a salted SHA-256 hash (security-model.md §2).
model ApiCredential {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  keyId          String       @unique
  secretHash     String
  secretSalt     String
  label          String
  scopes         String[]
  subjectKind    String       @default("SERVICE")
  expiresAt      DateTime?
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organisationId])
}

/// An agent's authority: bounded, expiring, and never wider than its principal's.
model AgentMandate {
  id                      String       @id @default(uuid())
  agentOrganisationId     String
  agent                   Organisation @relation("MandateAgent", fields: [agentOrganisationId], references: [id], onDelete: Cascade)
  principalOrganisationId String
  principal               Organisation @relation("MandatePrincipal", fields: [principalOrganisationId], references: [id])
  permittedActions        String[]
  maxTransactionValueMinor BigInt
  currency                String       @db.Char(3)
  expiresAt               DateTime
  revokedAt               DateTime?
  createdAt               DateTime     @default(now())

  @@index([agentOrganisationId])
}

// ------------------------------------------------------------- risk graph

enum NodeType {
  ENTITY
  ASSET
  DEPENDENCY
  RISK
  HAZARD
  EXPOSURE
  EVENT
  LOSS
  POLICY
  COVERAGE
  PREMIUM
  CLAIM
  CAPITAL
  SYNDICATE
  REINSURANCE_CONTRACT
  SETTLEMENT
}

enum EdgeType {
  OWNS
  DEPENDS_ON
  EXPOSED_TO
  MAY_CAUSE
  COVERS
  SUPPORTS
  ASSUMES
  PROTECTS
  REPRESENTS
  PAYS
  SUBJECT_TO
}

enum SourceKind {
  USER_DECLARED
  DOCUMENT
  EXTERNAL_FEED
  SENSOR
  DERIVED
  AI_INFERRED
}

model RiskNode {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  type           NodeType
  label          String
  jurisdiction   String       @db.Char(2)
  attributes     Json         @default("{}")

  // Provenance, inlined: a node cannot exist without it.
  sourceId        String
  sourceKind      SourceKind
  observedAt      DateTime
  recordedAt      DateTime
  confidence      Float
  transformations Json       @default("[]")
  modelId         String?
  modelVersion    String?
  referencedData  String[]

  outgoing RiskEdge[] @relation("EdgeFrom")
  incoming RiskEdge[] @relation("EdgeTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId, type])
  @@index([type])
  @@index([sourceKind])
}

model RiskEdge {
  id     String   @id @default(uuid())
  type   EdgeType
  fromId String
  from   RiskNode @relation("EdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     RiskNode @relation("EdgeTo", fields: [toId], references: [id], onDelete: Cascade)

  attributes Json @default("{}")

  sourceId        String
  sourceKind      SourceKind
  observedAt      DateTime
  recordedAt      DateTime
  confidence      Float
  transformations Json       @default("[]")
  modelId         String?
  modelVersion    String?
  referencedData  String[]

  createdAt DateTime @default(now())

  /// The same relationship must not be asserted twice.
  @@unique([type, fromId, toId])
  @@index([fromId, type])
  @@index([toId, type])
}

// ---------------------------------------------------------------- audit

/// Append-only. No update or delete path exists in application code, and the
/// migration revokes UPDATE/DELETE from the application role.
model AuditRecord {
  id                  String       @id @default(uuid())
  at                  DateTime     @default(now())
  actorOrganisationId String
  actorOrganisation   Organisation @relation(fields: [actorOrganisationId], references: [id])
  actorSubjectId      String
  actorSubjectKind    String
  action              String
  subjectType         String
  subjectId           String
  decision            String
  reason              String
  before              Json?
  after               Json?
  policy              String?
  modelId             String?
  modelVersion        String?
  ontologyVersion     String

  @@index([actorOrganisationId, at])
  @@index([subjectType, subjectId])
  @@index([action, at])
}

// -------------------------------------------------- submission (Phase 2/4)

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  ANALYSING
  SCORED
  READY_FOR_UNDERWRITING
}

/// Held in-memory through Phase 3; durable from Phase 4 because market
/// listing is the first thing that needs to read a submission back after a
/// restart (docs/reports/phase-4.md).
model RiskSubmission {
  id             String           @id @default(uuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  riskId         String
  title          String
  status         SubmissionStatus @default(DRAFT)
  submittedBy    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  listing MarketListing?

  @@index([organisationId, status])
  @@index([riskId])
}

// ------------------------------------------------- underwriting (Phase 3/4)

/// One row per assessment run. A risk may be re-assessed (new scoring input,
/// new model version); `clearance` always reads the latest by `assessedAt`.
model UnderwritingAssessment {
  id                    String   @id @default(uuid())
  riskId                String
  organisationId        String
  organisation          Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  eligible              Boolean
  band                  String
  control               String
  requiresHumanApproval Boolean
  riskScoreConfidence   Float
  expectedLossMinor     BigInt
  currency              String   @db.Char(3)
  premiumLowMinor       BigInt
  premiumHighMinor      BigInt
  capitalRequirementMinor BigInt
  suggestedCapacityMinor  BigInt
  exclusions            String[]
  conditions            String[]
  requiredEvidence      String[]
  modelVersion          String
  assessedAt            DateTime @default(now())

  approvals UnderwritingApproval[]

  @@index([riskId, assessedAt])
  @@index([organisationId])
}

model UnderwritingApproval {
  id                     String                 @id @default(uuid())
  riskId                 String
  assessment             UnderwritingAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId           String
  assessmentModelVersion String
  approverSubjectId      String
  decision               String
  reason                 String
  decidedAt              DateTime               @default(now())

  @@index([riskId, decidedAt])
}

// ---------------------------------------------------------- marketplace

enum ListingStatus {
  OPEN
  MATCHED
  WITHDRAWN
  EXPIRED
}

/// A cleared, underwritten risk offered to capital providers (brief §8).
/// Listing itself does not move capital — it only requires that
/// underwriting clearance already exists, checked at creation and re-checked
/// (not cached) so a later approval revocation cannot leave a stale listing
/// standing.
model MarketListing {
  id             String        @id @default(uuid())
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  submissionId   String        @unique
  submission     RiskSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  riskId         String
  title          String
  riskClass      String
  jurisdiction   String        @db.Char(2)
  capacityMinor  BigInt
  currency       String        @db.Char(3)
  durationDays   Int
  status         ListingStatus @default(OPEN)
  listedAt       DateTime      @default(now())
  closedAt       DateTime?

  interests CapitalInterest[]

  @@index([organisationId, status])
  @@index([riskClass, jurisdiction, status])
}

/// A capital provider's standing appetite (brief §8: preferred risk classes,
/// max exposure, geography, minimum return, duration, tolerance,
/// concentration limits). One row per organisation; updating replaces it.
model CapitalAppetiteProfile {
  id                    String   @id @default(uuid())
  organisationId        String   @unique
  organisation          Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  preferredRiskClasses  String[]
  maxExposureMinor      BigInt
  currency              String   @db.Char(3)
  preferredJurisdictions String[]
  minimumReturnBps      Int
  maxDurationDays        Int
  riskTolerance         String
  concentrationLimitBps  Int
  updatedAt             DateTime @updatedAt

  @@index([organisationId])
}

/// A capital provider's expressed, non-binding interest in a listing —
/// syndication (Phase 5) is what turns interest into a binding allocation.
model CapitalInterest {
  id             String        @id @default(uuid())
  listingId      String
  listing        MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  indicativeAmountMinor BigInt
  currency       String        @db.Char(3)
  note           String?
  expressedAt    DateTime      @default(now())
  withdrawnAt    DateTime?

  @@unique([listingId, organisationId])
  @@index([listingId])
  @@index([organisationId])
}
