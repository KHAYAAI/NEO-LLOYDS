// Neo-Lloyds — Phase 1 schema (identity + risk graph).
// SIMULATION / TEST ENVIRONMENT — NOT INSURANCE.
//
// Later phases add their own models and migrations rather than pre-building
// tables we cannot yet exercise (docs/roadmap.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- identity

enum OrganisationKind {
  COMPANY
  INDIVIDUAL
  AI_AGENT
  REGULATOR
}

enum KybStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum MarketRole {
  RISK_ORIGINATOR
  BROKER
  UNDERWRITER
  SYNDICATE
  CAPITAL_PROVIDER
  REINSURER
  INSURER
  CLAIMS_ADMINISTRATOR
  SETTLEMENT_PROVIDER
  REGULATOR
}

model Organisation {
  id           String           @id @default(uuid())
  legalName    String
  kind         OrganisationKind
  /// ISO-3166-1 alpha-2. Never defaulted (ADR-0004).
  jurisdiction String           @db.Char(2)
  kybStatus    KybStatus        @default(UNVERIFIED)
  active       Boolean          @default(true)

  /// Required for AI_AGENT: the legally responsible principal.
  principalOrganisationId String?
  principal               Organisation?  @relation("AgentPrincipal", fields: [principalOrganisationId], references: [id])
  agents                  Organisation[] @relation("AgentPrincipal")

  roles          OrganisationRole[]
  users          User[]
  credentials    ApiCredential[]
  mandates       AgentMandate[]     @relation("MandateAgent")
  grantedMandates AgentMandate[]    @relation("MandatePrincipal")
  nodes          RiskNode[]
  auditRecords   AuditRecord[]
  submissions           RiskSubmission[]
  underwritingAssessments UnderwritingAssessment[]
  listings              MarketListing[]
  capitalAppetite        CapitalAppetiteProfile?
  capitalInterests       CapitalInterest[]
  syndications           Syndication[]
  syndicationAllocations SyndicationAllocation[]
  capitalCommitment      CapitalCommitment?
  claims                 Claim[]
  claimPayouts           ClaimPayout[]
  simulationRuns         SimulationRun[]
  reinsurancePrograms    ReinsuranceProgram[]
  settlementTransactions SettlementTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jurisdiction])
  @@index([principalOrganisationId])
}

/// Each market function is a separate, separately auditable grant.
model OrganisationRole {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  role           MarketRole
  grantedAt      DateTime     @default(now())
  grantedBy      String

  @@unique([organisationId, role])
  @@index([role])
}

model User {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  email          String       @unique
  displayName    String
  active         Boolean      @default(true)
  /// Scopes granted to this user within the organisation.
  scopes         String[]
  /// OIDC identity link (the "authenticator" ApiCredentialGuard.resolve
  /// swaps in per docs/security-model.md §10). Both null until an admin
  /// links this user to a subject at a configured OIDC issuer; both set
  /// together, never independently.
  oidcIssuer     String?
  oidcSubject    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([oidcIssuer, oidcSubject])
  @@index([organisationId])
}

/// Secrets are stored only as a salted SHA-256 hash (security-model.md §2).
model ApiCredential {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  keyId          String       @unique
  secretHash     String
  secretSalt     String
  label          String
  scopes         String[]
  subjectKind    String       @default("SERVICE")
  expiresAt      DateTime?
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organisationId])
}

/// An agent's authority: bounded, expiring, and never wider than its principal's.
model AgentMandate {
  id                      String       @id @default(uuid())
  agentOrganisationId     String
  agent                   Organisation @relation("MandateAgent", fields: [agentOrganisationId], references: [id], onDelete: Cascade)
  principalOrganisationId String
  principal               Organisation @relation("MandatePrincipal", fields: [principalOrganisationId], references: [id])
  permittedActions        String[]
  maxTransactionValueMinor BigInt
  currency                String       @db.Char(3)
  expiresAt               DateTime
  revokedAt               DateTime?
  createdAt               DateTime     @default(now())

  @@index([agentOrganisationId])
}

// ------------------------------------------------------------- risk graph

enum NodeType {
  ENTITY
  ASSET
  DEPENDENCY
  RISK
  HAZARD
  EXPOSURE
  EVENT
  LOSS
  POLICY
  COVERAGE
  PREMIUM
  CLAIM
  CAPITAL
  SYNDICATE
  REINSURANCE_CONTRACT
  SETTLEMENT
}

enum EdgeType {
  OWNS
  DEPENDS_ON
  EXPOSED_TO
  MAY_CAUSE
  COVERS
  SUPPORTS
  ASSUMES
  PROTECTS
  REPRESENTS
  PAYS
  SUBJECT_TO
}

enum SourceKind {
  USER_DECLARED
  DOCUMENT
  EXTERNAL_FEED
  SENSOR
  DERIVED
  AI_INFERRED
}

model RiskNode {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  type           NodeType
  label          String
  jurisdiction   String       @db.Char(2)
  attributes     Json         @default("{}")

  // Provenance, inlined: a node cannot exist without it.
  sourceId        String
  sourceKind      SourceKind
  observedAt      DateTime
  recordedAt      DateTime
  confidence      Float
  transformations Json       @default("[]")
  modelId         String?
  modelVersion    String?
  referencedData  String[]

  outgoing RiskEdge[] @relation("EdgeFrom")
  incoming RiskEdge[] @relation("EdgeTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId, type])
  @@index([type])
  @@index([sourceKind])
}

model RiskEdge {
  id     String   @id @default(uuid())
  type   EdgeType
  fromId String
  from   RiskNode @relation("EdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     RiskNode @relation("EdgeTo", fields: [toId], references: [id], onDelete: Cascade)

  attributes Json @default("{}")

  sourceId        String
  sourceKind      SourceKind
  observedAt      DateTime
  recordedAt      DateTime
  confidence      Float
  transformations Json       @default("[]")
  modelId         String?
  modelVersion    String?
  referencedData  String[]

  createdAt DateTime @default(now())

  /// The same relationship must not be asserted twice.
  @@unique([type, fromId, toId])
  @@index([fromId, type])
  @@index([toId, type])
}

// ---------------------------------------------------------------- audit

/// Append-only. No update or delete path exists in application code, and the
/// migration revokes UPDATE/DELETE from the application role.
model AuditRecord {
  id                  String       @id @default(uuid())
  at                  DateTime     @default(now())
  actorOrganisationId String
  actorOrganisation   Organisation @relation(fields: [actorOrganisationId], references: [id])
  actorSubjectId      String
  actorSubjectKind    String
  action              String
  subjectType         String
  subjectId           String
  decision            String
  reason              String
  before              Json?
  after               Json?
  policy              String?
  modelId             String?
  modelVersion        String?
  ontologyVersion     String

  @@index([actorOrganisationId, at])
  @@index([subjectType, subjectId])
  @@index([action, at])
}

// -------------------------------------------------- submission (Phase 2/4)

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  ANALYSING
  SCORED
  READY_FOR_UNDERWRITING
}

/// Held in-memory through Phase 3; durable from Phase 4 because market
/// listing is the first thing that needs to read a submission back after a
/// restart (docs/reports/phase-4.md).
model RiskSubmission {
  id             String           @id @default(uuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  riskId         String
  title          String
  status         SubmissionStatus @default(DRAFT)
  submittedBy    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  listing MarketListing?

  @@index([organisationId, status])
  @@index([riskId])
}

// ------------------------------------------------- underwriting (Phase 3/4)

/// One row per assessment run. A risk may be re-assessed (new scoring input,
/// new model version); `clearance` always reads the latest by `assessedAt`.
model UnderwritingAssessment {
  id                    String   @id @default(uuid())
  riskId                String
  organisationId        String
  organisation          Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  eligible              Boolean
  band                  String
  control               String
  requiresHumanApproval Boolean
  riskScoreConfidence   Float
  expectedLossMinor     BigInt
  currency              String   @db.Char(3)
  premiumLowMinor       BigInt
  premiumHighMinor      BigInt
  capitalRequirementMinor BigInt
  suggestedCapacityMinor  BigInt
  exclusions            String[]
  conditions            String[]
  requiredEvidence      String[]
  modelVersion          String
  assessedAt            DateTime @default(now())

  approvals UnderwritingApproval[]

  @@index([riskId, assessedAt])
  @@index([organisationId])
}

model UnderwritingApproval {
  id                     String                 @id @default(uuid())
  riskId                 String
  assessment             UnderwritingAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId           String
  assessmentModelVersion String
  approverSubjectId      String
  decision               String
  reason                 String
  decidedAt              DateTime               @default(now())

  @@index([riskId, decidedAt])
}

// ---------------------------------------------------------- marketplace

enum ListingStatus {
  OPEN
  MATCHED
  WITHDRAWN
  EXPIRED
}

/// A cleared, underwritten risk offered to capital providers (brief §8).
/// Listing itself does not move capital — it only requires that
/// underwriting clearance already exists, checked at creation and re-checked
/// (not cached) so a later approval revocation cannot leave a stale listing
/// standing.
model MarketListing {
  id             String        @id @default(uuid())
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  submissionId   String        @unique
  submission     RiskSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  riskId         String
  title          String
  riskClass      String
  jurisdiction   String        @db.Char(2)
  capacityMinor  BigInt
  currency       String        @db.Char(3)
  durationDays   Int
  status         ListingStatus @default(OPEN)
  listedAt       DateTime      @default(now())
  closedAt       DateTime?

  interests   CapitalInterest[]
  syndication Syndication?

  @@index([organisationId, status])
  @@index([riskClass, jurisdiction, status])
}

/// A capital provider's standing appetite (brief §8: preferred risk classes,
/// max exposure, geography, minimum return, duration, tolerance,
/// concentration limits). One row per organisation; updating replaces it.
model CapitalAppetiteProfile {
  id                    String   @id @default(uuid())
  organisationId        String   @unique
  organisation          Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  preferredRiskClasses  String[]
  maxExposureMinor      BigInt
  currency              String   @db.Char(3)
  preferredJurisdictions String[]
  minimumReturnBps      Int
  maxDurationDays        Int
  riskTolerance         String
  concentrationLimitBps  Int
  updatedAt             DateTime @updatedAt

  @@index([organisationId])
}

/// A capital provider's expressed, non-binding interest in a listing —
/// syndication (Phase 5) is what turns interest into a binding allocation.
model CapitalInterest {
  id             String        @id @default(uuid())
  listingId      String
  listing        MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  indicativeAmountMinor BigInt
  currency       String        @db.Char(3)
  note           String?
  expressedAt    DateTime      @default(now())
  withdrawnAt    DateTime?

  @@unique([listingId, organisationId])
  @@index([listingId])
  @@index([organisationId])
}

// ---------------------------------------------------------- syndication

/// A syndication divides one listing's capacity across capital providers
/// (brief §9). Proposed allocations remain freely add/removable while OPEN;
/// binding (packages/domain/src/syndication.ts: bindAllocations) is the one
/// crossing from non-binding interest to committed capital, and once BOUND
/// no allocation for this syndication may be mutated — enforced both in the
/// service layer and by a database trigger below.
model Syndication {
  id             String   @id @default(uuid())
  listingId      String   @unique
  listing        MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id])
  capacityMinor  BigInt
  currency       String   @db.Char(3)
  /// OPEN | BOUND | CANCELLED
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())
  boundAt        DateTime?

  allocations SyndicationAllocation[]
  events      SyndicationAllocationEvent[]
  claims      Claim[]

  @@index([organisationId, status])
}

/// Current proposal state. Freely mutable while the parent syndication is
/// OPEN; a trigger refuses UPDATE/DELETE once it is BOUND, so the binding
/// commitment cannot be altered even by direct database access.
model SyndicationAllocation {
  id             String      @id @default(uuid())
  syndicationId  String
  syndication    Syndication @relation(fields: [syndicationId], references: [id], onDelete: Cascade)
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  shareBps       Int
  amountMinor    BigInt
  currency       String      @db.Char(3)
  createdAt      DateTime    @default(now())

  @@unique([syndicationId, organisationId])
  @@index([syndicationId])
}

/// Append-only, forever — enforced by trigger, same pattern as AuditRecord.
/// Every propose/remove/bind action is recorded here and never removed, even
/// after the corresponding SyndicationAllocation row is deleted (on
/// withdrawal) or frozen (on binding). This is the "immutable allocation
/// history" the brief requires.
model SyndicationAllocationEvent {
  id             String      @id @default(uuid())
  syndicationId  String
  syndication    Syndication @relation(fields: [syndicationId], references: [id], onDelete: Cascade)
  organisationId String
  /// PROPOSED | REMOVED | BOUND
  action         String
  shareBps       Int
  amountMinor    BigInt
  currency       String      @db.Char(3)
  actorSubjectId String
  recordedAt     DateTime    @default(now())

  @@index([syndicationId, recordedAt])
}

// ---------------------------------------------------------- capital ledger

/// A capital provider's declared platform-wide ceiling (brief §10). Exposure
/// itself is not stored here — it is computed on read from every
/// SyndicationAllocation the provider holds, across every syndication, so
/// there is exactly one source of truth for "what has this provider actually
/// allocated" and it cannot drift from a separately-maintained running total.
model CapitalCommitment {
  id             String       @id @default(uuid())
  organisationId String       @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  committedMinor BigInt
  currency       String       @db.Char(3)
  updatedAt      DateTime     @updatedAt
  createdAt      DateTime     @default(now())
}

// -------------------------------------------------------------- claims

enum ClaimStatus {
  REPORTED
  EVIDENCE_COLLECTED
  VERIFIED
  COVERAGE_CONFIRMED
  LOSS_CALCULATED
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  SETTLED
}

/// Brief §13: Incident -> Evidence -> Verification -> Coverage Check -> Loss
/// Calculation -> Human Review if required -> Approval -> Settlement ->
/// Audit. Filed against a BOUND Syndication — see
/// packages/domain/src/claims.ts: requireCoverage refuses anything else, and
/// enforces a running total across every prior claim on the same
/// syndication, not just this one.
model Claim {
  id                String      @id @default(uuid())
  syndicationId     String
  syndication       Syndication @relation(fields: [syndicationId], references: [id])
  riskId            String
  organisationId    String
  organisation      Organisation @relation(fields: [organisationId], references: [id])
  status            ClaimStatus @default(REPORTED)
  incidentDescription String
  evidenceRefs      String[]    @default([])
  reportedBy        String
  claimedLossMinor  BigInt?
  currency          String?     @db.Char(3)
  reviewDecision     String?    // AUTO | HUMAN_REVIEW, set once loss is calculated
  approverSubjectId String?
  approvalDecision  String?     // APPROVED | REJECTED
  approvalReason    String?
  decidedAt         DateTime?
  settledAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  payouts ClaimPayout[]

  @@index([syndicationId, status])
  @@index([organisationId])
}

/// One row per capital provider's share of an approved claim's loss —
/// computed once, at approval, via the same exact-sum allocation used to
/// bind the syndication in the first place (ADR-0005). This is the concrete
/// record of a bound allocation being tested against a real loss.
model ClaimPayout {
  id             String   @id @default(uuid())
  claimId        String
  claim          Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  amountMinor    BigInt
  currency       String   @db.Char(3)
  createdAt      DateTime @default(now())

  @@unique([claimId, organisationId])
  @@index([claimId])
  @@index([organisationId])
}

/// Phase 8 — Simulation & Digital Twin. The first phase that runs *forward*
/// from the risk graph rather than processing something that already
/// happened. Persisted so a scenario result is a durable, auditable,
/// retrievable record — the same reasoning as every other analytical output
/// in this system — not a fire-and-forget computation.
enum SimulationScenarioKind {
  PORT_CLOSURE
  SUPPLY_CHAIN_DISRUPTION
  COMMODITY_SHOCK
  WEATHER
  INFRASTRUCTURE_FAILURE
  COUNTERPARTY_FAILURE
  GEOPOLITICAL
  CYBER
}

model SimulationRun {
  id                String                 @id @default(uuid())
  organisationId    String
  organisation      Organisation           @relation(fields: [organisationId], references: [id])
  requestedBy       String
  scenarioKind      SimulationScenarioKind
  triggerNodeId     String
  durationDays      Int
  severity          Float
  description       String?
  currency          String                 @db.Char(3)
  /// Full SimulationResult (affected assets, exposed entities, correlated
  /// exposure, capital requirement, insured/uninsured split), stored as JSON
  /// rather than normalised across half a dozen join tables — this is a
  /// read-mostly analytical snapshot, not a record anything else joins
  /// against transactionally.
  result            Json
  createdAt         DateTime               @default(now())

  @@index([organisationId, createdAt])
}

/// Phase 9 — Reinsurance. Configurable layers over a cedant's own retained
/// loss, as software abstractions a program is configured with — not
/// regulated reinsurance contracts. A program belongs to a cedant
/// organisation (typically holding SYNDICATE role) and holds an ordered set
/// of layers a loss is run through by `applyReinsuranceProgram`
/// (packages/domain/src/reinsurance.ts).
enum ReinsuranceLayerKind {
  QUOTA_SHARE
  EXCESS_OF_LOSS
  AGGREGATE
}

model ReinsuranceProgram {
  id             String              @id @default(uuid())
  organisationId String
  organisation   Organisation        @relation(fields: [organisationId], references: [id])
  name           String
  currency       String              @db.Char(3)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  layers    ReinsuranceLayer[]
  cessions  ReinsuranceCession[]

  @@index([organisationId])
}

model ReinsuranceLayer {
  id        String               @id @default(uuid())
  programId String
  program   ReinsuranceProgram   @relation(fields: [programId], references: [id], onDelete: Cascade)
  order     Int
  kind      ReinsuranceLayerKind
  /// QuotaShareParams | ExcessOfLossParams | AggregateParams (packages/domain/src/reinsurance.ts) as JSON.
  params    Json
  /// AGGREGATE layers only: cumulative gross/ceded consumed so far this
  /// program period, carried forward between cessions. Zero and unused for
  /// QUOTA_SHARE/EXCESS_OF_LOSS, which are stateless per loss.
  aggregateConsumedGrossMinor BigInt @default(0)
  aggregateConsumedCededMinor BigInt @default(0)

  @@unique([programId, order])
  @@index([programId])
}

model ReinsuranceCession {
  id             String             @id @default(uuid())
  programId      String
  program        ReinsuranceProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  /// Optional link to the Claim this cession was computed against — a
  /// program can also be exercised against a bare loss figure with no claim
  /// (e.g. exploratory "what would this cede" calls), so this is nullable.
  claimId        String?
  grossLossMinor BigInt
  totalCededMinor BigInt
  netRetainedMinor BigInt
  currency       String             @db.Char(3)
  /// Full ProgramCessionResult (per-layer breakdown), stored as JSON for the
  /// same read-mostly-analytical-snapshot reason SimulationRun.result is.
  perLayer       Json
  createdAt      DateTime           @default(now())

  @@index([programId, createdAt])
  @@index([claimId])
}

/// Phase 10 — Settlement. This is where Phase 7's claims "settled" status —
/// a bare state-machine flag, no money moving — gets real transaction
/// infrastructure behind it: a full record for every settlement attempt,
/// regardless of provider. No cryptocurrency is hard-coded — STABLECOIN is
/// one of three settlement *methods* a program can request, not an
/// implementation of any specific chain.
enum SettlementMethodKind {
  BANK_TRANSFER
  DIGITAL_MONEY
  STABLECOIN
}

enum SettlementTransactionStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
}

model SettlementTransaction {
  id              String                      @id @default(uuid())
  organisationId  String
  organisation    Organisation                @relation(fields: [organisationId], references: [id])
  /// Optional link to the ClaimPayout this settlement is discharging — a
  /// settlement can also be requested standalone (e.g. a reinsurance
  /// recovery, a manual correction), so this is nullable.
  claimPayoutOrganisationId String?
  claimPayoutClaimId        String?
  method          SettlementMethodKind
  status          SettlementTransactionStatus @default(PENDING)
  grossAmountMinor BigInt
  feeMinor         BigInt
  netAmountMinor   BigInt
  currency         String                     @db.Char(3)
  /// The provider's own reference for this transaction, once submitted —
  /// null until SUBMITTED. Format is provider-specific and opaque here.
  providerRef      String?
  /// Human-readable detail on a FAILED transaction, if the provider gave one.
  failureReason    String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([organisationId, createdAt])
  @@index([claimPayoutClaimId])
}
