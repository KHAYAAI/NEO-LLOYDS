# Neo-Lloyds local development
DATABASE_URL="postgresql://neolloyds:neolloyds@localhost:5432/neolloyds?schema=public"
REDIS_URL="redis://localhost:6379"
API_PORT=3001
NODE_ENV=development
# Banner shown on every API response. Do not remove in non-production.
SIMULATION_MODE=true

# Optional: AI Risk Analyst provider. Unset -> the null provider, which is
# fully functional and returns a grounded MISSING_INFORMATION finding.
# ANTHROPIC_API_KEY=

# --- Hardening (docs/security-model.md §9) ---
# Comma-separated browser origins allowed to call this API cross-origin.
# Empty/unset -> no browser origin is allowed (server-to-server callers are
# unaffected; CORS is a browser-only enforcement mechanism).
# CORS_ALLOWED_ORIGINS=https://app.neo-lloyds.example
# IP-based rate limit window and ceiling, in front of the per-credential
# auth guard. Defaults are generous for local dev, not tuned for production.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=300
# Swagger/OpenAPI UI at /docs. On by default outside NODE_ENV=production;
# must be explicitly opted into in production.
# ENABLE_API_DOCS=false

# --- OIDC / human sign-in (docs/security-model.md §10) ---
# Unset -> OIDC is disabled; only <keyId>.<secret> API credentials work, same
# as before this was added. Set OIDC_ISSUER_URL to a real, registered
# identity provider's issuer to enable it -- this repository verifies real
# signatures against it (via `jose`), it does not simulate one.
# OIDC_ISSUER_URL=https://your-tenant.okta.com/oauth2/default
# Expected `aud` claim, if your provider sets one. Omit to skip the check.
# OIDC_AUDIENCE=neo-lloyds-api
# Optional: fetch signing keys from a specific JWKS endpoint instead of the
# default `${OIDC_ISSUER_URL}/.well-known/jwks.json`.
# OIDC_JWKS_URL=
# Optional: a static JWKS JSON, for offline dev/test verification without
# network access to a real provider. Do not set this in production.
# OIDC_JWKS_STATIC_JSON=

# --- WorkOS AuthKit specifically (apps/admin-portal ships a real sign-in
# flow against it -- see that app's README) ---
# The JWKS URL below was read directly out of the installed
# @workos-inc/node SDK's own source (UserManagement.getJwksUrl in
# node_modules/@workos-inc/node/lib/factory-*.mjs), not guessed -- this
# repository had no network access to workos.com/api.workos.com to
# confirm it any other way. What that source does NOT reveal is the
# exact `iss` claim WorkOS's own token issuer puts on an access token
# (WorkOS's own SDK verifies these tokens by signature only, with no
# issuer check in its reference implementation). Decode one real AuthKit
# access token from your environment before setting OIDC_ISSUER_URL below
# to anything other than a placeholder -- an unconfirmed guess there will
# reject every real WorkOS token.
# OIDC_ISSUER_URL=<confirm from a real decoded access token first>
# OIDC_JWKS_URL=https://api.workos.com/sso/jwks/client_01M0DMPW9VVWVXC5PZHAEW6S2K

# --- Didit KYB (apps/api/src/compliance/didit.ts) ---
# Unset -> createKybProvider() falls back to NullKybProvider (§8 of
# security-model.md) -- runComplianceChecks records "not screened", it
# never fabricates a pass. Set DIDIT_API_KEY from your Didit dashboard to
# turn real KYB registry lookups on.
# DIDIT_API_KEY=
#
# These two have NO default -- confirm the exact paths from your Didit
# dashboard's API reference. This repository's sandbox could not reach
# docs.didit.me/verification.didit.me/apidocs.didit.me (network egress
# blocked or DNS failure) to confirm them directly; the request/response
# *shapes* the adapter expects were verified live through Didit's own MCP
# connector instead (didit_verify_kyb_search / didit_verify_kyb_select
# against the sandbox app, country GB). Setting DIDIT_API_KEY without
# both of these throws at startup rather than silently no-op-ing.
# DIDIT_KYB_SEARCH_URL=
# DIDIT_KYB_SELECT_URL=
#
# Same account, one more endpoint -- Didit AML screening (sanctions/PEP
# lists, optionally adverse media) behind SanctionsProvider
# (apps/api/src/compliance/didit.ts). Same DIDIT_API_KEY above turns this
# on too, once its own endpoint URL is set (same "no default, confirm
# from the dashboard" reasoning):
# DIDIT_AML_SCREEN_URL=
